FROM python:3.11-slim
RUN pip install --no-cache-dir pandas numpy scipy statsmodels scikit-learn matplotlib
WORKDIR /app
COPY eda_python_worker.py /app/eda_python_worker.py
ENV MPLCONFIGDIR=/tmp/matplotlib OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
USER 65534:65534
ENTRYPOINT ["python", "-I", "/app/eda_python_worker.py"]
